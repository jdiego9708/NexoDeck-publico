# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Instaladores generados por scripts/build_installer.ps1
dist/

# Salidas de compilacion del sidecar de sensores (.NET). El binario que se
# empaqueta sale de `melos run sensors:build` y cae en dist/, ya ignorado.
sensors/**/bin/
sensors/**/obj/
