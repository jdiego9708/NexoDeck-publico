# commitea en core/crates/nexodeck-editor/assets/.
node_modules/
**/*.rs.bk
Cargo.lock.bak

# Dart / Flutter
.dart_tool/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/build/
app/windows/flutter/ephemeral/
app/linux/flutter/ephemeral/
app/android/.gradle/
app/android/local.properties
app/android/gradlew
app/android/gradlew.bat
app/android/gradle/
*.iml
.pub-cache/
.pub/

# Nota: app/lib/bridge_generated/ y el glue Rust generado por
